# Files NOT pushed to Apps Script (ignore-list style for clasp v3).
# The Apps Script project must contain ONLY: appsscript.json + src/**/*.js + src/**/*.html
# + the GAS test suites (tests/*.js). The Node-only harness (require/vm) must be excluded or it
# breaks Apps Script compilation.
.git/**
node_modules/**
docs/**
release/**
sample-data/**
tests/node/**
**/*.md
package.json
.gitignore
.claspignore
.clasp.json.standalone-bak
